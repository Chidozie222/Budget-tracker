    "name": "100 week budget",
    "income": 40000,
    "end_date": "2026-09-24"
}

### get all budgets
GET {{baseUrl}}/budgets
Authorization: Bearer {{accessToken}}

### get budget
GET {{baseUrl}}/budgets/4
Authorization: Bearer {{accessToken}}

